{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zola",
  "version": "1.3.0",
  "identifier": "dev.zola.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ZOLA // VOICE TERMINAL",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:5001 ws://localhost:*; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/zola-daemon"
    ],
    "linux": {
      "deb": {
        "depends": ["libportaudio2"],
        "files": {
          "/usr/lib/udev/rules.d/70-zola-uinput.rules": "resources/70-zola-uinput.rules",
          "/usr/bin/zola-trigger": "resources/zola-trigger"
        }
      },
      "rpm": {
        "depends": ["portaudio"],
        "files": {
          "/usr/lib/udev/rules.d/70-zola-uinput.rules": "resources/70-zola-uinput.rules",
          "/usr/bin/zola-trigger": "resources/zola-trigger"
        }
      }
    }
  }
}
